{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Agent Office",
  "version": "0.1.0",
  "identifier": "com.agentoffice.app",
  "build": {
    "beforeDevCommand": "pnpm exec next dev --port 5173 --turbopack",
    "beforeBuildCommand": "node scripts/tauri-before-build.mjs",
    "frontendDist": "http://localhost:5173",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "server",
      "binaries/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
