{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Agent Office",
  "version": "0.1.15",
  "identifier": "com.agentoffice.app",
  "build": {
    "beforeDevCommand": "pnpm exec next dev --port 5173 --turbopack",
    "beforeBuildCommand": "unset __NEXT_PRIVATE_STANDALONE_CONFIG && pnpm exec next build && node scripts/prepare-bundle.mjs",
    "frontendDist": "http://localhost:5173",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/nakotomagami-a11y/agent-orchestrator/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2NUY0RjhCMUMyNUY5NzkKUldSNStTVWNpMDlmTnZqR3NNMENyMzZZcWR0QWdKYk9Kem9FVEZTODJyM0FoajlKaTRoeWoxRjEK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "server",
      "binaries/node-*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": null
    }
  }
}
